# Copy to .env and adjust for your environment
DATABASE_URL=postgresql+psycopg2://exo:change_me@localhost:5432/exoplanets
REDIS_URL=redis://localhost:6379/0

# Comma-separated allowed browser origins (production)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Reproducible orbital-gap N-body trials
ORBITAL_SEED=42

# Docker Compose defaults (override in .env)
POSTGRES_USER=exo
POSTGRES_PASSWORD=change_me
POSTGRES_DB=exoplanets
